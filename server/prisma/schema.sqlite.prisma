// Dailyuse 数据模型（PostgreSQL）
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ========== 用户 ==========
model User {
  id        String   @id @default(uuid())
  openid    String   @unique 
  nickname  String?  
  avatarUrl String?  @map("avatar_url") 
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ===== 权益（付费骨架）=====
  // tier：free | pro；paidUntil 为 null 表示永久有效
  tier      String    @default("free")
  paidUntil DateTime? @map("paid_until")

  todos      Todo[]
  notes      Note[]
  accounts   Account[]
  countdowns Countdown[]
  wheels     Wheel[]
  habits     Habit[]
  reminders  Reminder[]
  memberships GroupMember[]
  ownedGroups Group[]      @relation("GroupOwner")
  groupTodos  GroupTodo[]
  pushLogs    PushLog[]
  foods       FoodRecord[]
  feedback    Feedback[]

  @@map("users")
}

// ========== 工具：待办 ==========
model Todo {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String   
  done      Boolean  @default(false)
  doneAt    DateTime? @map("done_at")
  category  String   @default("default") 
  dueAt     DateTime? @map("due_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, done, createdAt])
  @@map("todos")
}

// ========== 工具：便签 ==========
model Note {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String   @default("") 
  content   String   @default("") 
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pinned, updatedAt])
  @@map("notes")
}

// ========== 工具：记账 ==========
model Account {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  type       String    // income | expense
  amount     Decimal  
  category   String   
  remark     String   @default("") 
  occurredAt DateTime @default(now()) @map("occurred_at") 
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@map("accounts")
}

// ========== 工具：倒数日 ==========
model Countdown {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  name       String   
  targetDate DateTime @map("target_date") 
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, targetDate])
  @@map("countdowns")
}

// ========== 工具：转盘 ==========
// items 为 JSON 字符串数组（自定义选项，2-12 条）
model Wheel {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String   @default("转盘")
  items     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("wheels")
}

// ========== 工具：打卡 ==========
// 用户自定义打卡项；记录在 HabitLog（一天一条）
model Habit {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId, archived, createdAt])
  @@map("habits")
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String   @map("habit_id")
  userId    String   @map("user_id")
  day       DateTime
  createdAt DateTime @default(now()) @map("created_at")

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, day])
  @@index([userId, day])
  @@map("habit_logs")
}

// ========== 群组：投票 ==========
model GroupPoll {
  id        String    @id @default(uuid())
  groupId   String    @map("group_id")
  question  String
  multi     Boolean   @default(false)
  deadline  DateTime? @map("deadline")
  createdBy String    @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")

  group   Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  options GroupPollOption[]
  votes   GroupPollVote[]

  @@index([groupId, createdAt])
  @@map("group_polls")
}

model GroupPollOption {
  id      String   @id @default(uuid())
  pollId  String   @map("poll_id")
  content String
  sort    Int      @default(0)
  votes   GroupPollVote[]

  poll GroupPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId])
  @@map("group_poll_options")
}

// 一人一票（单选）或一人多票（多选）：同一选项一人只投一次
model GroupPollVote {
  id        String   @id @default(uuid())
  pollId    String   @map("poll_id")
  optionId  String   @map("option_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  poll   GroupPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option GroupPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([pollId, userId])
  @@map("group_poll_votes")
}

// ========== 群组：倒数日 ==========
model GroupCountdown {
  id         String   @id @default(uuid())
  groupId    String   @map("group_id")
  name       String
  targetDate DateTime @map("target_date")
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, targetDate])
  @@map("group_countdowns")
}

// ========== 群组：接龙 ==========
// 报名/集合接龙：标题 + 按加入顺序编号的条目，一人一条
model GroupChain {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  title     String
  closed    Boolean  @default(false)
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  group   Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entries GroupChainEntry[]

  @@index([groupId, createdAt])
  @@map("group_chains")
}

model GroupChainEntry {
  id        String   @id @default(uuid())
  chainId   String   @map("chain_id")
  userId    String   @map("user_id")
  remark    String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  chain GroupChain @relation(fields: [chainId], references: [id], onDelete: Cascade)

  @@unique([chainId, userId])
  @@map("group_chain_entries")
}

// ========== 推送日志（工具提醒） ==========
model PushLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  channel    String    // news | reminder
  reminderId String?  @map("reminder_id")
  status     String    // sent | failed | skipped
  sentAt     DateTime @default(now()) @map("sent_at")

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@map("push_logs")
}

// ========== 工具提醒（额度制） ==========
model Reminder {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  toolType  String   @map("tool_type")  // todo | countdown | group_todo | note | weather
  targetId  String   @map("target_id")
  remindAt  DateTime @map("remind_at")
  // 定期提醒：'' | daily | weekly | monthly；空 = 只提醒一次
  repeat    String   @default("")
  // 每月重复的原始日期（1-31），短月夹紧后仍能恢复到原日期；旧记录首次发送时补齐
  repeatDay Int?     @map("repeat_day")
  // 建提醒时前端授权用的模板 ID；空则推送时回退到 WX_TEMPLATE_ID
  templateId String  @default("") @map("template_id")
  // 天气订阅的城市名（toolType=weather 时写，推送时填进「城市」栏目）；其余工具为空
  city      String?
  remain    Int      @default(1)
  status    String   @default("pending")  // pending | sent | expired | canceled
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, remindAt])
  @@map("reminders")
}

// ========== 协作群组 ==========
model Group {
  id         String   @id @default(uuid())
  name       String   
  ownerId    String   @map("owner_id")
  inviteCode String   @unique @map("invite_code") 
  // 群内工具配置（JSON 数组）：[{ key, label, kind }]
  tools      String   @default("") 
  createdAt  DateTime @default(now()) @map("created_at")

  owner   User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMember[]
  todos   GroupTodo[]
  items    GroupListItem[]
  expenses GroupExpense[]
  events   GroupEvent[]
  scores   GroupScore[]
  orders   GroupOrder[]
  polls   GroupPoll[]
  countdowns GroupCountdown[]
  chains  GroupChain[]

  @@map("groups")
}

// ========== 群组：购物清单 ==========
model GroupListItem {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  // 属于哪个工具（预设 list/notice/... 或自定义工具 key）
  toolKey   String   @default("list") @map("tool_key") 
  content   String   
  // 副信息：链接地址 / 单号 / 做法
  note      String   @default("") 
  // 公告等需要置顶
  pinned    Boolean  @default(false)
  done      Boolean  @default(false)
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, toolKey, done, createdAt])
  @@map("group_list_items")
}

// ========== 群组：AA 记账 ==========
model GroupExpense {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  title     String   
  amount    Decimal  
  payerId   String   @map("payer_id")
  createdAt DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@map("group_expenses")
}

// ========== 群组：活动 ==========
model GroupEvent {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  title     String   
  startAt   DateTime @map("start_at")
  place     String   @default("") 
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, startAt])
  @@map("group_events")
}

// ========== 群组：计分 ==========
model GroupScore {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  userId    String?  @map("user_id")
  delta     Int
  reason    String   @default("") 
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@map("group_scores")
}

// ========== 群组：点餐 ==========
model GroupOrder {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  content   String   
  done      Boolean  @default(false)
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, done, createdAt])
  @@map("group_orders")
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String   @map("group_id")
  userId   String   @map("user_id")
  role     String   @default("member")  // owner | member
  joinedAt DateTime @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model GroupTodo {
  id         String    @id @default(uuid())
  groupId    String    @map("group_id")
  title      String    
  done       Boolean   @default(false)
  assigneeId String?   @map("assignee_id")
  dueAt      DateTime? @map("due_at")
  createdBy  String    @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignee User? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([groupId, done])
  @@map("group_todos")
}

// ========== 美食记录 ==========
// ========== 用户反馈 ==========
model Feedback {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  // bug = 遇到问题 | idea = 功能建议 | tool = 想要的新工具 | other = 其他
  kind      String
  content   String
  status    String   @default("new") // new | handled
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("feedback")
}

// ========== 管理员公告 ==========
model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("announcements")
}

model FoodRecord {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  kind      String    // ate 今天吃了 | want 想吃什么
  content   String   
  note      String   @default("") 
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@map("food_records")
}
