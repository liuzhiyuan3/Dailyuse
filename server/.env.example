# ===== 服务 =====
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://dailyuse:change-me@localhost:5432/dailyuse
JWT_SECRET=change-me-to-a-long-random-string

# 可信代理：决定 req.ip 取哪个头，直接影响限流是否可被绕过。
# 默认只信本机回环。nginx 跑在容器里时改成它的出口网关（如 172.17.0.1）。
# 严禁写 true。
TRUST_PROXY=127.0.0.1,::1

# CORS 白名单（逗号分隔）。小程序请求不带 Origin，用不到 CORS，留空=完全关闭。
CORS_ORIGIN=

# ===== 微信小程序（不配 secret 则登录走 dev 模式，openid=dev-<code>）=====
WX_APPID=
WX_SECRET=
WX_TEMPLATE_ID=
# 本地调试固定身份：设了它，每次登录都是同一个账号（不设则每次 code 不同会新建用户）
DEV_OPENID=
# NODE_ENV=production 且未配 WX_SECRET 时，登录接口默认返回 503（防止伪造 code 登录）。
# 确需在预发环境使用调试登录，显式打开这个开关。
ALLOW_DEV_LOGIN=

# ===== 资讯源（三选一，按优先级）=====
# 1) JSON API：URL 中用 {keyword} 占位
NEWS_API_URL=
NEWS_API_KEY=
# 2) RSS：逗号分隔多个地址，按关键词过滤标题和摘要（无需 key）
NEWS_RSS_URLS=
# 单用户每天可手动触发的抓取次数（防滥用放大）
NEWS_REFRESH_PER_DAY=20
# 单次外网抓取超时（毫秒）
NEWS_FETCH_TIMEOUT_MS=8000
PUSH_PER_KEYWORD_PER_DAY=3
QUIET_START_HOUR=22
QUIET_END_HOUR=8

# ===== 付费骨架 =====
# 1 = free 用户访问 pro 接口得到 402；0（默认）= 只记日志放行。
# 支付没接之前保持 0，接了支付回调再打开。
PAY_ENFORCED=0
