# ===== 服务 =====
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://dailyuse:change-me@localhost:5432/dailyuse
JWT_SECRET=change-me-to-a-long-random-string

# 可信代理：决定 req.ip 取哪个头，直接影响限流是否可被绕过。
# 默认只信本机回环。nginx 跑在容器里时改成它的出口网关（如 172.17.0.1）。
# 严禁写 true。
TRUST_PROXY=127.0.0.1,::1

# CORS 白名单（逗号分隔）。小程序请求不带 Origin，用不到 CORS，留空=完全关闭。
CORS_ORIGIN=

# ===== 微信小程序（不配 secret 则登录走 dev 模式，openid=dev-<code>）=====
WX_APPID=
WX_SECRET=
# 工具提醒（待办/倒数日/群组待办/便签）的订阅消息模板 ID（日程提醒类）
WX_TEMPLATE_ID=
# 天气订阅专用模板 ID（天气提醒类，字段结构与上面那个不同）
WX_WEATHER_TEMPLATE_ID=

# ===== 和风天气（每日天气推送）：控制台凭据里的 API Key 与专属 API Host =====
QWEATHER_KEY=
QWEATHER_HOST=

# 本地调试固定身份：设了它，每次登录都是同一个账号（不设则每次 code 不同会新建用户）
DEV_OPENID=
# 管理员 openid 白名单（逗号分隔）：反馈管理 / 公告发布。冒烟测试需设 dev-admin
ADMIN_OPENIDS=
# 网页管理后台：生产 https://admin.benefitgpt.top，本地 http://localhost:3000/admin。
# 登录密码留空 = 关闭；冒烟测试需设 dev-pass。
ADMIN_PASSWORD=
# NODE_ENV=production 且未配 WX_SECRET 时，登录接口默认返回 503（防止伪造 code 登录）。
# 确需在预发环境使用调试登录，显式打开这个开关。
ALLOW_DEV_LOGIN=


PUSH_PER_KEYWORD_PER_DAY=3
QUIET_START_HOUR=22
QUIET_END_HOUR=8

# ===== 付费骨架 =====
# 1 = free 用户访问 pro 接口得到 402；0（默认）= 只记日志放行。
# 支付没接之前保持 0，接了支付回调再打开。
PAY_ENFORCED=0
