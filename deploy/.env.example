# ===== 数据库与鉴权（必填）=====
POSTGRES_DB=dailyuse
POSTGRES_USER=dailyuse
POSTGRES_PASSWORD=please-change-me
JWT_SECRET=please-change-to-a-long-random-string

# ===== 微信小程序（不配 secret 时登录走 dev 模式；生产环境会被 503 拒绝）=====
WX_APPID=
WX_SECRET=
# 工具提醒（待办/倒数日/群组待办）的订阅消息模板 ID
WX_TEMPLATE_ID=
# 管理员 openid（逗号分隔，可多个）：登录一次后在「我的 → 管理后台」发通知、看反馈。
# 查自己的 openid：管理员先登录一次，服务端日志或 users 表里可见
ADMIN_OPENIDS=
# 网页管理后台（https://admin.benefitgpt.top）的登录密码；留空 = 关闭
ADMIN_PASSWORD=

# nginx 不在本机回环时改这里（例如 nginx 跑在容器里：172.17.0.1）。严禁 true。
TRUST_PROXY=127.0.0.1,::1


# ===== 推送与付费（一般用默认即可）=====
# 每关键词每日推送上限 / 免打扰时段
PUSH_PER_KEYWORD_PER_DAY=3
QUIET_START_HOUR=22
QUIET_END_HOUR=8
# 1 = free 用户访问 pro 接口得到 402；接支付前保持 0
PAY_ENFORCED=0
